{
  "name": "vascular-plant-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive atlas of 480 living vascular plant families",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "node scripts/serve.js",
    "data:display": "node scripts/build-display-metadata.js",
    "data:display:refresh": "node scripts/build-display-metadata.js --refresh-names",
    "validate": "node scripts/validate-atlas.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/app.js && node --check scripts/serve.js && npm run validate && npm test"
  },
  "engines": { "node": ">=18" },
  "devDependencies": { "opencc-js": "^1.0.5" }
}
